{
  "name": "desktop-ui-toolkit-from-scratch",
  "version": "0.0.0",
  "private": true,
  "description": "\"Making a Desktop UI Toolkit From Scratch\" — a talk about react-x11, presented in an app built with react-x11",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "tsx src/main.tsx",
    "x11": "REACT_X11_BACKEND=x11 tsx src/main.tsx",
    "workbench": "bunx @react-x11/workbench dev",
    "devtools": "react-devtools",
    "example:devtools": "REACT_X11_DEVTOOLS=1 tsx examples/devtools-demo.tsx",
    "example:hot": "node --enable-source-maps --import react-x11/refresh/register examples/hot-demo.jsx",
    "typecheck": "tsc --noEmit",
    "shot": "tsx scripts/shot.tsx",
    "render": "tsx scripts/render.tsx",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@react-x11/components": "^0.7.0",
    "react": "^19.2.8",
    "react-x11": "^2.10.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@react-x11/workbench": "^0.2.0",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "hot-module-replacement": "^4.0.1",
    "pngjs": "^7.0.0",
    "react-devtools": "^7.0.1",
    "react-devtools-core": "^7.0.1",
    "react-refresh": "^0.18.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "ws": "^8.21.3"
  }
}
